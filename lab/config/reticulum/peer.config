# LXMF counterpart driver's Reticulum instance (normal profile; loopback only).
# Seeded by lab/up.sh into lab/state/lxmf/reticulum-peer/config; used by
# lab/tools/lxmf_counterpart.py run inside the medre-normal container
# (docker compose exec medre-normal python /opt/lab-tools/lxmf_counterpart.py ...).
# Confined to 127.0.0.1 inside the container network namespace.
[reticulum]
  enable_transport = No
  share_instance = No

[logging]
  loglevel = 4

[interfaces]
  [[loopback-to-medre]]
    type = UDPInterface
    enabled = Yes
    listen_ip = 127.0.0.1
    listen_port = 4243
    forward_ip = 127.0.0.1
    forward_port = 4242
