# medre-normal's embedded Reticulum instance (normal profile; loopback only).
# Seeded by lab/up.sh into the medre-normal state volume as /data/reticulum/config.
# Confined to 127.0.0.1 inside the container network namespace.
[reticulum]
  enable_transport = No
  share_instance = No

[logging]
  loglevel = 4

[interfaces]
  [[loopback-to-counterpart]]
    type = UDPInterface
    enabled = Yes
    listen_ip = 127.0.0.1
    listen_port = 4242
    forward_ip = 127.0.0.1
    forward_port = 4243
