# shellcheck shell=bash
# =============================================================================
# Scenario layer configuration (scenarios side of the rig contract).
#
# Sourced by lab/run-scenarios.sh and every scenario script. Values below are
# the CONTRACT DEFAULTS matching the rig topology as of the owner's
# per-meshnet x per-channel room correction (2026-11-10):
#   * each instance has TWO nodes on its mesh: the relay node
#     (meshtasticd-a / meshtasticd-b, connected to its mmrelay) and a PEER
#     node (meshtasticd-a-peer / meshtasticd-b-peer) used for realistic
#     third-party radio identity and far-side delivery observation;
#   * rooms are PER MESHNET x CHANNEL: #lab-alpha-ch0, #lab-alpha-ch2,
#     #lab-beta-ch0, #lab-beta-ch2 (both relays join all four and map each to
#     the same channel index on their own radio); #lab-other stays unmapped.
# The rig may override any value in lab/state/scenario.env (sourced LAST).
#
# All paths are paths INSIDE the lab-tools container. All hostnames are
# compose service names resolvable from lab-tools' networks.
# =============================================================================

# --- Execution -------------------------------------------------------------
# Compose file and project used by the runner (host-side paths).
LAB_COMPOSE_FILE="${LAB_COMPOSE_FILE:-${LAB_ROOT}/compose.yaml}"
LAB_COMPOSE_PROFILES="${LAB_COMPOSE_PROFILES:-}"
# Where scenarios/lib is mounted inside lab-tools (REQUIREMENT FOR THE RIG).
SCENARIOS_LIB_DIR="${SCENARIOS_LIB_DIR:-/scenarios/lib}"

# --- Matrix (from lab-tools' network view) ---------------------------------
SYNAPSE_URL="${SYNAPSE_URL:-http://synapse:8008}"
LAB_SERVER_NAME="${LAB_SERVER_NAME:-lab.test}"
# Provisioned accounts/rooms/tokens: written by lab/tools/provision.py.
LAB_RUNTIME_JSON="${LAB_RUNTIME_JSON:-/lab-state/runtime.json}"

# --- Matrix rooms (per meshnet x channel; aliases via scenario.env) --------
ROOM_ALPHA_CH0_ALIAS="${ROOM_ALPHA_CH0_ALIAS:-#lab-alpha-ch0:lab.test}"
ROOM_ALPHA_CH2_ALIAS="${ROOM_ALPHA_CH2_ALIAS:-#lab-alpha-ch2:lab.test}"
ROOM_BETA_CH0_ALIAS="${ROOM_BETA_CH0_ALIAS:-#lab-beta-ch0:lab.test}"
ROOM_BETA_CH2_ALIAS="${ROOM_BETA_CH2_ALIAS:-#lab-beta-ch2:lab.test}"
# Unmapped room used by cross-room-rejection (mapped NOWHERE by design).
ROOM_OTHER_ALIAS="${ROOM_OTHER_ALIAS:-#lab-other:lab.test}"

# --- Relay bots -------------------------------------------------------------
BOT_A_MXID="${BOT_A_MXID:-@relay-a:lab.test}"
BOT_B_MXID="${BOT_B_MXID:-@relay-b:lab.test}"
BOT_C_MXID="${BOT_C_MXID:-@relay-c:lab.test}"
UNTRUSTED_LOCALPART="${UNTRUSTED_LOCALPART:-untrusted}"
DRIVER_LOCALPART="${DRIVER_LOCALPART:-admin}"

# --- Simulated human users (rig-provisioned; tokens via scenario.env or
#     runtime.json users.{localpart}) ----------------------------------------
HUMAN_ALICE_LOCALPART="${HUMAN_ALICE_LOCALPART:-alice}"
HUMAN_BOB_LOCALPART="${HUMAN_BOB_LOCALPART:-bob}"

# --- Meshnets ---------------------------------------------------------------
MESHNET_A="${MESHNET_A:-AlphaLab}"
MESHNET_B="${MESHNET_B:-BetaLab}"

# --- Meshtasticd nodes (from lab-tools' network view) -----------------------
# RELAY nodes are connected to their mmrelay; scenario radio actions originate
# from the PEER nodes (third-party radio identity), and far-side delivery is
# observed on the far mesh's PEER node API (never on relay-connected nodes:
# a second API client can disturb the relay's connection).
NODE_A_HOST="${NODE_A_HOST:-meshtasticd-a}"
NODE_A_PORT="${NODE_A_PORT:-4403}"
NODE_A_PEER_HOST="${NODE_A_PEER_HOST:-meshtasticd-a-peer}"
NODE_A_PEER_PORT="${NODE_A_PEER_PORT:-4403}"
NODE_B_HOST="${NODE_B_HOST:-meshtasticd-b}"
NODE_B_PORT="${NODE_B_PORT:-4403}"
NODE_B_PEER_HOST="${NODE_B_PEER_HOST:-meshtasticd-b-peer}"
NODE_B_PEER_PORT="${NODE_B_PEER_PORT:-4403}"
NODE_C_HOST="${NODE_C_HOST:-meshtasticd-c}"
NODE_C_PORT="${NODE_C_PORT:-4403}"

# --- NORMAL topology (compose profile normal; scenario-normal-*.sh) ---------
# Two mmrelays mapping ONLY the shared bridge rooms + ONE medre instance
# whose meshtastic adapter owns NEW MeshC (node meshtasticd-c-medre is
# medre-OWNED: never inject or sniff there; tooling uses the c-peer).
ROOM_BRIDGE_CH0_ALIAS="${ROOM_BRIDGE_CH0_ALIAS:-#lab-bridge:lab.test}"
ROOM_BRIDGE_CH2_ALIAS="${ROOM_BRIDGE_CH2_ALIAS:-#lab-bridge-ch2:lab.test}"
MEDRE_NORMAL_SERVICE="${MEDRE_NORMAL_SERVICE:-medre-normal}"
MEDRE_NORMAL_MAP_DB="${MEDRE_NORMAL_MAP_DB:-/state/medre-normal/state/medre.sqlite}"
MEDRE_NORMAL_BOT_MXID="${MEDRE_NORMAL_BOT_MXID:-@medre:lab.test}"
MEDRE_NORMAL_RADIO_ADAPTER="${MEDRE_NORMAL_RADIO_ADAPTER:-}"
NORMAL_MMRELAY_SERVICES="${NORMAL_MMRELAY_SERVICES:-mmrelay-a mmrelay-b}"
NORMAL_PEER_SERVICES="${NORMAL_PEER_SERVICES:-meshtasticd-a-peer meshtasticd-b-peer meshtasticd-c-peer}"
NODE_C_MEDRE_HOST="${NODE_C_MEDRE_HOST:-meshtasticd-c-medre}"
NODE_C_PEER_HOST="${NODE_C_PEER_HOST:-meshtasticd-c-peer}"
NODE_C_PEER_PORT="${NODE_C_PEER_PORT:-4403}"
MESHNET_C="${MESHNET_C:-}"
MEDRE_NORMAL_LXMF="${MEDRE_NORMAL_LXMF:-}"
MEDRE_NORMAL_LXMF_ADAPTER="${MEDRE_NORMAL_LXMF_ADAPTER:-lxmf0}"
MEDRE_QUEUE_LOG_A="${MEDRE_QUEUE_LOG_A:-/state/mmrelay-a/logs/mmrelay.log}"
MEDRE_QUEUE_LOG_B="${MEDRE_QUEUE_LOG_B:-/state/mmrelay-b/logs/mmrelay.log}"

# --- Relay SQLite message maps (inside lab-tools) ---------------------------
# Relay home is /data; db_utils puts the map at <home>/database/meshtastic.sqlite.
# lab-tools mounts relay state read-only at /state/mmrelay-<x>.
MAP_DB_A="${MAP_DB_A:-/state/mmrelay-a/database/meshtastic.sqlite}"
MAP_DB_B="${MAP_DB_B:-/state/mmrelay-b/database/meshtastic.sqlite}"
MAP_DB_C="${MAP_DB_C:-/state/mmrelay-c/database/meshtastic.sqlite}"

# --- echo_observed plugin observation files (inside lab-tools) -------------
PLUGIN_OBS_A="${PLUGIN_OBS_A:-/lab-logs/scenarios/echo-observed-a.jsonl}"
PLUGIN_OBS_B="${PLUGIN_OBS_B:-/lab-logs/scenarios/echo-observed-b.jsonl}"
PLUGIN_OBS_C="${PLUGIN_OBS_C:-/lab-logs/scenarios/echo-observed-c.jsonl}"

# --- Timing -----------------------------------------------------------------
MATRIX_WAIT_SECONDS="${MATRIX_WAIT_SECONDS:-90}"
RADIO_WAIT_SECONDS="${RADIO_WAIT_SECONDS:-90}"
SNIFF_WAIT_SECONDS="${SNIFF_WAIT_SECONDS:-45}"
SETTLE_SECONDS="${SETTLE_SECONDS:-6}"
